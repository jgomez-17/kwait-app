generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  category    String
  image       String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
}
